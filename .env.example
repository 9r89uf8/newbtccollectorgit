DATABASE_URL=postgres://btc_collector:change-me@127.0.0.1:5432/btc_collector
PGSSL=false

COLLECTOR_NAME=btc-price-collector
COLLECTOR_SYMBOL=BTCUSDT
BINANCE_TIMEOUT_MS=4000
ENABLE_FUTURES_MICROSTRUCTURE=true
ENABLE_FUTURES_POSITIONING=true
ENABLE_FUTURES_WEBSOCKET_SUMMARIES=true
ENABLE_POLYMARKET_BTC_5M=true
BINANCE_BASIS_PERIOD=5m
BINANCE_BASIS_CONTRACT_TYPE=PERPETUAL
BINANCE_FUTURES_PUBLIC_WS_BASE_URL=wss://fstream.binance.com/public/stream
BINANCE_FUTURES_MARKET_WS_BASE_URL=wss://fstream.binance.com/market/stream
POLYMARKET_TIMEOUT_MS=4000
ENABLE_POLYMARKET_CHAINLINK_BTC_PRICE=true
POLYMARKET_RTDS_WS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_CHAINLINK_BTC_SYMBOL=btc/usd
POLYMARKET_RTDS_PING_INTERVAL_MS=5000
POLYMARKET_RTDS_STALE_MS=15000
POLYMARKET_CLOB_WS_PING_INTERVAL_MS=10000
POLYMARKET_CLOB_WS_SYNC_INTERVAL_MS=5000
FORWARD_LABEL_MIN_THRESHOLD_BPS=1
LARGE_TRADE_QUOTE_THRESHOLD=1000000
MAX_AGG_TRADE_PAGES_PER_MARKET=30

ENABLE_LIVE_DASHBOARD=true
LIVE_DASHBOARD_HOST=127.0.0.1
LIVE_DASHBOARD_PORT=8787
LIVE_DASHBOARD_BROADCAST_MS=500
LIVE_STATE_PERSIST_INTERVAL_MS=1000
LIVE_COLLECTOR_URL=http://127.0.0.1:8787

PORT=3000

