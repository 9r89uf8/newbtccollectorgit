[Unit]
Description=newbtccollector BTC price collector
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/newbtccollector
EnvironmentFile=/opt/newbtccollector/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run collector
Restart=always
RestartSec=5
User=btc

[Install]
WantedBy=multi-user.target
